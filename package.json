{
  "name": "heic-to-jpg",
  "version": "1.2.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npm run build:css && node server.js",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/style.css --watch",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/style.css",
    "build:css:prod": "tailwindcss -i ./src/input.css -o ./public/style.css --minify",
    "build": "npm run build:css:prod"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "bree": "^9.2.4",
    "dcraw": "^1.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "fs": "0.0.1-security",
    "heic-convert": "^1.0.6",
    "jimp": "^1.6.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.5",
    "sharp": "^0.34.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.0"
  }
}
